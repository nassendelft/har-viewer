headers = ftxui_c_api.h
package = ftxui_c
staticLibraries = libftxui_c_binding.a libftxui-component.a libftxui-dom.a libftxui-screen.a

linkerOpts.linux_x64 = -L/usr/lib/x86_64-linux-gnu -L/lib/x86_64-linux-gnu -lstdc++ -lm
linkerOpts.linux_arm64 = -L/usr/lib/aarch64-linux-gnu -L/lib/aarch64-linux-gnu -lstdc++ -lm